{
  "name": "fmvz-halloween-concurso",
  "version": "1.0.0",
  "private": true,
  "description": "Segundo Concurso de Disfraces FMVZ - UNAM (3 de noviembre de 2026)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "start": "node server/dist/index.js",
    "seed": "npm run seed --workspace=server",
    "test": "npm run test --workspace=server",
    "load-test": "node scripts/load-test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
