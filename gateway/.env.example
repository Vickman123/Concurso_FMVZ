# Puerto local en Render (asignado automáticamente por Render en producción)
PORT=3000

# URL destino del VPS en OVHcloud
OVH_BACKEND_URL=http://135.148.166.89

# Secreto compartido inter-servidor (64 caracteres hex o token seguro)
# Debe coincidir exactamente con el GATEWAY_SECRET configurado en el backend de OVH
GATEWAY_SECRET=fmvz_gateway_secure_shared_token_2026_super_secret_key

# Ruta local del bundle compilado de React (opcional, por defecto ../client/dist)
CLIENT_DIST_PATH=../client/dist
