# ==============================================================================
# FMVZ Halloween Contest — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como .env y configura los valores correspondientes.
# NUNCA agregues contraseñas reales a este archivo versionado en Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuración del Servidor Node.js / Express
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Base de Datos PostgreSQL
# ------------------------------------------------------------------------------
# En VPS Hostinger (Docker):
# DATABASE_URL=postgres://fmvz_admin:TU_CONTRASENA_SEGURA@127.0.0.1:5432/fmvz_halloween
#
# En Docker Compose (comunicación inter-contenedor):
# DATABASE_URL=postgres://fmvz_admin:TU_CONTRASENA_SEGURA@db:5432/fmvz_halloween
#
# En Supabase / Cloud (temporal previo a migración):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgres://fmvz_admin:genera_un_password_seguro_aqui@127.0.0.1:5432/fmvz_halloween

# Control de SSL para PostgreSQL ('true' para Supabase/Cloud, 'false' para Docker/VPS local)
DATABASE_SSL=false

# Parámetros del Pool de Conexiones
DB_POOL_MAX=25
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=5000

# Variables para contenedor Docker de PostgreSQL (docker-compose)
POSTGRES_DB=fmvz_halloween
POSTGRES_USER=fmvz_admin
POSTGRES_PASSWORD=genera_un_password_seguro_aqui

# ------------------------------------------------------------------------------
# 3. Almacenamiento Persistente de Fotografías
# ------------------------------------------------------------------------------
# Modo de almacenamiento: 'disk' (recomendado para VPS/Docker) o 'base64' (fallback)
STORAGE_MODE=disk

# Directorio físico donde se almacenan las fotografías de los disfraces
# En contenedor Docker: /app/server/uploads
# En VPS Host (sin docker): /var/www/concurso-fmvz/server/uploads
UPLOAD_DIR=/app/server/uploads

# ------------------------------------------------------------------------------
# 4. Seguridad y Autenticación JWT
# ------------------------------------------------------------------------------
# Clave criptográfica para firma de tokens de sesión administrativa (mínimo 32 caracteres)
JWT_SECRET=cambia_esta_clave_por_una_cadena_aleatoria_larga_y_segura_de_64_bytes

# ------------------------------------------------------------------------------
# 5. Configuración del Frontend (Vite)
# ------------------------------------------------------------------------------
# Dejar vacío si el frontend es servido por el mismo servidor Node.js (mismo origen)
# Si el frontend se aloja en Render y el backend en VPS: https://api.tu-dominio-vps.com
VITE_API_URL=
